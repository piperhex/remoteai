NODE_ENV=production
LISTEN_PORT=8080
PUBLIC_DIR=/app/public

# Keep the existing deployment's database and Redis values when migrating.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=codex_switch
POSTGRES_PASSWORD=
POSTGRES_DB=codex_switch
POSTGRES_SSLMODE=disable
POSTGRES_DB_SYNCHRONIZE=false
# Per-process pool; keep headroom for other instances and database administration.
POSTGRES_MAX_OPEN_CONNS=30
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_LOCK_TIMEOUT_MS=5000
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Trust only the ingress proxy addresses (comma-separated CIDRs); empty means no trusted proxy.
# Configure the actual proxy /32 or /128 before enabling source limits behind a gateway.
TRUSTED_PROXY_CIDRS=
TELEMETRY_GLOBAL_REQUESTS_PER_MINUTE=2000
TELEMETRY_SOURCE_REQUESTS_PER_MINUTE=120
TELEMETRY_DEVICE_REQUESTS_PER_MINUTE=12
TELEMETRY_SOURCE_INSTALLATIONS_PER_HOUR=30
TELEMETRY_SOURCE_INSTALLATIONS_PER_DAY=100
TELEMETRY_GLOBAL_INSTALLATIONS_PER_DAY=1000

# Existing installation: preserve all three values. New installation: generate independent random secrets.
KONG_JWT_KEY=codex-switch
KONG_JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_TTL_SECONDS=2592000

CHAT_STUN_PORT=3478
CHAT_STUN_BIND=0.0.0.0
CHAT_STUN_URLS=
# Independent bulk accounting gate; apply 20261005-chat-bulk-leases.sql before upgrading.
CHAT_BULK_LEASES_ENABLED=false
# Optional Expo/APNs notifications. Provider secrets stay on the server.
CHAT_PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
# Optional Windows unattended desktop, after applying 20260928-desktop-service.sql.
DESKTOP_SERVICE_ENABLED=false
# Optional native TCP hole punching. Publish TCP 3478 separately from UDP STUN.
CHAT_TCP_URLS=
CHAT_TCP_LISTEN=0.0.0.0:3478
# Optional metered desktop TURN; enable compose.desktop-relay.yml and use a separate random secret.
# Video credentials are issued only to authenticated, paired desktop sessions.
DESKTOP_TURN_URLS=
DESKTOP_TURN_SECRET=
DESKTOP_TURN_REALM=codex-switch
DESKTOP_TURN_PUBLIC_IP=
# Optional TLS listener requires mounted PEM certificate/key files and its TCP port published.
DESKTOP_TURN_TLS_LISTEN=
DESKTOP_TURN_TLS_CERT=
DESKTOP_TURN_TLS_KEY=
# Alternative trusted private certificate-manager endpoint returning {"cert":"PEM","key":"PEM"}.
# Refreshed every minute; never use a public or user-controlled URL.
DESKTOP_TURN_TLS_CERT_URL=
CODEX_OAUTH_ISSUER=https://auth.openai.com
CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# Match the original deployment's effective proxy; leave empty for a direct connection.
CODEX_OUTBOUND_PROXY=http://host.docker.internal:7890

mail__transport=SMTP
mail__options__host=
mail__options__port=465
mail__options__secure=true
mail__options__auth__user=
mail__options__auth__pass=
mail__from=

# Existing installation: retain its PostgreSQL/Redis network. New installation: create this network first.
# ADMIN_GO_NETWORK remains a fallback when ADMIN_GO_DB_NETWORK is unset.
ADMIN_GO_DB_NETWORK=codex-switch-data
ADMIN_GO_KONG_NETWORK=kong-net
# Match the live Kong upstream; preserve existing custom aliases and Compose overrides.
ADMIN_GO_KONG_ALIAS=codex-switch-admin-go
ADMIN_GO_BIND=127.0.0.1
ADMIN_GO_PORT=8080
# Public STUN binding must match CHAT_STUN_URLS and the host firewall.
ADMIN_GO_STUN_BIND=0.0.0.0
ADMIN_GO_STUN_PORT=3478

# Pin this to the locally built and uploaded image tag when releasing.
ADMIN_GO_IMAGE=codex-switch/admin-go:local
# Used only by compose.infrastructure.yml for a new installation.
ADMIN_GO_POSTGRES_DATA=/srv/codex-switch/postgres
