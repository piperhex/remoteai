{
  "name": "@codex-switch/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --config scripts/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/prepare-assets.mjs && vite build --config scripts/vite.config.ts && vite build --config scripts/vite.config.ts --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "check": "npm run build && npm run test",
    "test": "node --test tests/export.test.mjs",
    "test:e2e": "playwright test --config scripts/playwright.config.ts",
    "preview": "vite preview --config scripts/vite.config.ts --host 127.0.0.1 --port 4175"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@remoteai/i18n": "0.1.30",
    "antd": "^5.29.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.34.5",
    "typescript": "~5.6.3",
    "vite": "^6.0.5"
  }
}
