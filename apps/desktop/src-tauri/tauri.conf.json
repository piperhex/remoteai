{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote AI",
  "version": "1.7.4",
  "identifier": "dev.codex.switch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node ../../scripts/prepare-desktop-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Remote AI",
        "width": 1370,
        "height": 760,
        "minWidth": 1200,
        "minHeight": 680,
        "center": true,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: http: https:",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "frame-src": "'self' http://127.0.0.1:*",
        "object-src": "http://127.0.0.1:*",
        "media-src": "'self' http://127.0.0.1:*",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.github.com ws: wss:"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cswitch"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDNzM5NjczQzMxNTBBQjcKUldTM0NoWERjNVp6L0ZxQ0k3ZzhJUGV4U1FVajBQdkZCclV6K1lkU3U5VXA2MDh6ZE5sK3Z4UXIK",
      "endpoints": [
        "https://github.com/piperhex/remoteai/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "resources/dream-skin/assets/**/*",
      "resources/dream-skin/LICENSE",
      "resources/dream-skin/NOTICE.md",
      "resources/remote-desktop/**/*",
      "resources/desktop-service/**/*",
      "resources/chat-connectivity/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Manage and switch multiple Codex accounts",
    "longDescription": "A local-first manager for Codex auth.json files and account usage windows.",
    "windows": {
      "wix": {
        "upgradeCode": "f65516b1-807b-5d58-952e-3cd240f3fbad",
        "version": "1.7.4",
        "fragmentPaths": [
          "windows/installer-lifecycle.wxs"
        ],
        "featureRefs": [
          "CswInstallerLifecycle"
        ]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-"
    }
  }
}
