{
  "name": "@codex-switch/native",
  "version": "1.7.17",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "postinstall": "node ./scripts/patch-drawer-taps.cjs && node ./scripts/patch-list-render-range.cjs && node ./scripts/patch-webrtc-ice.cjs && node ./scripts/patch-tcp-punch.cjs",
    "start": "node ./scripts/expo.cjs start",
    "android": "node ./scripts/expo.cjs start --android",
    "ios": "node ./scripts/expo.cjs start --ios",
    "export:android": "node ./scripts/expo.cjs export --platform android --output-dir node_modules/.expo-export",
    "export:ios": "node ./scripts/expo.cjs export --platform ios --output-dir node_modules/.expo-export-ios",
    "prebuild:android": "node ./scripts/expo.cjs prebuild --platform android --clean --no-install",
    "build:apk": "node ./scripts/build-apk.cjs",
    "prebuild:ios": "node ./scripts/expo.cjs prebuild --platform ios --clean --no-install",
    "check": "node ./scripts/build-terminal-document.cjs --check && node ./scripts/build-math-css.cjs --check && node ./scripts/build-desktop-ime.cjs --check && node ./scripts/build-text-selection.cjs --check && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^12.0.0",
    "@expo/vector-icons": "^14.1.0",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "buffer": "^6.0.3",
    "expo": "^53.0.0",
    "expo-application": "~6.1.4",
    "expo-asset": "~11.1.7",
    "expo-camera": "~16.1.11",
    "expo-clipboard": "~7.1.5",
    "expo-crypto": "~14.1.5",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-media-library": "~17.1.7",
    "expo-notifications": "^0.31.5",
    "expo-screen-orientation": "~8.1.7",
    "expo-secure-store": "~14.2.0",
    "expo-sensors": "~14.1.4",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "markdown-it": "^15.0.1",
    "markdown-it-texmath": "^1.0.0",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-blob-util": "^0.24.10",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-webrtc": "124.0.8",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/react": "~19.0.10",
    "@types/sql.js": "^1.4.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "sql.js": "^1.14.2",
    "typescript": "~5.8.3",
    "vitest": "^4.1.9"
  }
}
