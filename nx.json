{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/shared/**/*", "{workspaceRoot}/apps/web/src/**/*"],
      "dependsOn": [
        "^build"
      ]
    },
    "check": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/shared/**/*", "{workspaceRoot}/apps/web/src/**/*"],
      "dependsOn": [
        "^check"
      ]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/shared/**/*", "{workspaceRoot}/apps/web/src/**/*"]
    },
    "test:typecheck": {
      "cache": true
    }
  }
}
