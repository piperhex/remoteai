{
  "name": "codex-switch",
  "private": true,
  "version": "2.2.3",
  "license": "Apache-2.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/desktop",
    "apps/website",
    "packages/i18n"
  ],
  "scripts": {
    "dev": "npm run dev -w @codex-switch/desktop",
    "dev:desktop": "npm run dev -w @codex-switch/desktop",
    "dev:app": "npm run dev:app -w @codex-switch/desktop",
    "dev:admin": "npm --prefix apps/admin-ui run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:website": "npm run dev -w @codex-switch/website",
    "dev:backend": "go -C apps/admin run ./cmd/admin",
    "build": "lerna run build --stream",
    "build:desktop": "npm run build -w @codex-switch/desktop",
    "build:admin": "npm --prefix apps/admin-ui run build",
    "build:web": "npm --prefix apps/web run build",
    "build:website": "npm run build -w @codex-switch/website",
    "clean": "node scripts/clean-project.mjs",
    "clean:preview": "npm run clean -- --dry-run",
    "test:clean": "node --test scripts/clean-project.test.mjs",
    "check:website": "npm run check -w @codex-switch/website",
    "test:website:e2e": "npm run test:e2e -w @codex-switch/website",
    "build:backend": "go -C apps/admin build -o dist/ ./cmd/admin",
    "deploy:admin": "node scripts/deploy.mjs admin",
    "deploy:web": "node scripts/deploy.mjs web",
    "test:backend": "go -C apps/admin test ./...",
    "check:backend": "npm --prefix apps/admin run check",
    "build:apk": "npm --prefix apps/native run build:apk",
    "build:app": "npm run build:app -w @codex-switch/desktop",
    "build:app:mac": "npm run build:app:mac -w @codex-switch/desktop",
    "build:app:win-arm64": "npm run build:app:win-arm64 -w @codex-switch/desktop",
    "check": "npm run check:boundaries && npm run test:clean && node scripts/i18n.mjs check-host && lerna run check --stream && npm run check:rust",
    "check:rust": "npm run check:rust -w @codex-switch/desktop",
    "test": "lerna run test --stream",
    "preview": "npm run preview -w @codex-switch/desktop",
    "tauri": "npm run tauri -w @codex-switch/desktop",
    "commitlint": "commitlint",
    "prepare": "husky",
    "nx": "nx",
    "graph": "nx graph",
    "affected": "nx affected",
    "stats:cloc": "node scripts/stats-cloc.mjs",
    "release": "node scripts/tag-release.mjs",
    "release-beta": "node scripts/tag-release.mjs --beta",
    "check:i18n": "node scripts/i18n.mjs check",
    "generate:i18n": "node scripts/i18n.mjs generate",
    "check:admin": "npm --prefix apps/admin-ui run check",
    "export:admin-ui": "node scripts/export-admin-ui-dependencies.mjs",
    "export:native": "node scripts/export-native-dependencies.mjs",
    "check:web": "npm --prefix apps/web run check",
    "export:web": "node scripts/export-web-dependencies.mjs",
    "check:boundaries": "node --test shared/scripts/source-boundaries.test.mjs shared/testing/chatSessions.test.mjs && node shared/scripts/check-boundaries.mjs --host ."
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "esbuild": "0.25.12",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "nx": "^23.0.1"
  }
}
