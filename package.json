{
  "name": "codex-switch",
  "private": true,
  "version": "1.7.24",
  "license": "Apache-2.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @codex-switch/desktop",
    "dev:desktop": "npm run dev -w @codex-switch/desktop",
    "dev:app": "npm run dev:app -w @codex-switch/desktop",
    "dev:admin": "npm run dev -w @codex-switch/admin-ui",
    "dev:web": "npm run dev -w @codex-switch/web",
    "dev:backend": "go -C apps/admin-go run ./cmd/admin-go",
    "build": "lerna run build --ignore @codex-switch/backend --stream && npm run build:backend",
    "build:desktop": "npm run build -w @codex-switch/desktop",
    "build:admin": "npm run build -w @codex-switch/admin-ui",
    "build:web": "npm run build -w @codex-switch/web",
    "build:backend": "go -C apps/admin-go build -o dist/ ./cmd/admin-go",
    "test:backend": "go -C apps/admin-go test ./...",
    "check:backend": "node apps/admin-go/scripts/extract-contract.mjs --check && go -C apps/admin-go vet ./... && npm run test:backend",
    "build:apk": "npm run build:apk -w @codex-switch/native",
    "build:app": "npm run build:app -w @codex-switch/desktop",
    "build:app:mac": "npm run build:app:mac -w @codex-switch/desktop",
    "build:app:win-arm64": "npm run build:app:win-arm64 -w @codex-switch/desktop",
    "check": "lerna run check --ignore @codex-switch/backend --stream && npm run check:backend && npm run check:rust",
    "check:rust": "npm run check:rust -w @codex-switch/desktop",
    "test": "lerna run test --stream",
    "preview": "npm run preview -w @codex-switch/desktop",
    "tauri": "npm run tauri -w @codex-switch/desktop",
    "commitlint": "commitlint",
    "prepare": "husky",
    "nx": "nx",
    "graph": "nx graph",
    "affected": "nx affected",
    "stats:cloc": "cloc . --exclude-dir=.git,node_modules,dist,target,coverage,.nx,.idea,.codex-tmp,docs,public,resources,icons,gen --not-match-f=\"(package-lock\\.json|\\.min\\.(js|css)$)\" --exclude-ext=md",
    "release": "node scripts/tag-release.mjs",
    "release-beta": "node scripts/tag-release.mjs --beta"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "esbuild": "0.25.12",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "nx": "^23.0.1"
  }
}
